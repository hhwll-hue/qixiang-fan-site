{
    # 用于自动申请 HTTPS 证书（生产环境建议填写真实邮箱）
 # 本地开发可不设置 email
}

# 站点地址：本地默认 localhost；生产环境改成你的域名
{$SITE_ADDRESS:localhost} {
       bind 0.0.0.0
    # 启用压缩，提升静态资源加载速度
    encode zstd gzip

    # API 路由：/api/* → api:8000
    # handle_path 会剥离 /api 前缀，API 内部看到的是 /health、/quote 等
    handle_path /api/* {
        reverse_proxy api:8000
    }

    # 站点路由：其它请求 → site:1313（Hugo 开发服务器）
    handle {
        reverse_proxy site:1313
    }
}
